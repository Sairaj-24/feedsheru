# Used to sign session cookies. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-string

# --- Postgres ---
# Neon: paste pooled + direct URLs from the Neon console (or `neon env pull`).
# Any other Postgres (Docker, RDS, local): one URL is enough; you can omit UNPOOLED.
#
# Driver is auto-detected from the hostname (*.neon.tech → neon, else pg).
# Override with: DATABASE_DRIVER=neon  or  DATABASE_DRIVER=pg

DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Session cookies: unset = Secure when NODE_ENV=production.
# Docker Compose HTTP sets AUTH_COOKIE_SECURE=false (see .env.docker.example).
# AUTH_COOKIE_SECURE=false

# Docker Compose self-host example (host = service name `db`):
# DATABASE_DRIVER=pg
