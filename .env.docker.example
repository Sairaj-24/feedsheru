# Copy to `.env` for Docker Compose:
#   cp .env.docker.example .env
#
# Generate AUTH_SECRET with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

AUTH_SECRET=replace-with-a-long-random-string

# HTTP Compose (localhost) must keep this false so session cookies stick.
# Set to true when the app is served over HTTPS.
AUTH_COOKIE_SECURE=false

POSTGRES_USER=feedsheru
POSTGRES_PASSWORD=feedsheru
POSTGRES_DB=feedsheru
POSTGRES_PORT=5432
APP_PORT=3000

# Compose builds DATABASE_URL from POSTGRES_* (host = service name `db`).
# Change POSTGRES_PASSWORD here; you do not also need a separate URL.
DATABASE_DRIVER=pg
